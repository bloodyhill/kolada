/tools/train/.venv/
/tools/train/data/
/tools/train/out/

# Personal Claude Code settings; the shared ones are .claude/settings.json.
.claude/settings.local.json
# The user's own files and local logs, never committed.
/newlogo*
/@2x*
/tools/train/out-*.log
/.claude/worktrees/
/.claude/launch.json
