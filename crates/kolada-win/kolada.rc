// The app icon, and the taskbar menu's (a note, a new note, search, Beam): made
// by tools/icongen.
1 ICON "kolada.ico"
2 ICON "jump-note.ico"
3 ICON "jump-new.ico"
4 ICON "jump-search.ico"
5 ICON "jump-beam.ico"

// What Windows calls the app: the taskbar's menu, Task Manager, Explorer.
1 VERSIONINFO
FILEVERSION 0,4,5,0
PRODUCTVERSION 0,4,5,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Kolada"
            VALUE "FileDescription", "Kolada"
            VALUE "FileVersion", "0.4.5"
            VALUE "InternalName", "kolada"
            VALUE "OriginalFilename", "kolada.exe"
            VALUE "ProductName", "Kolada"
            VALUE "ProductVersion", "0.4.5"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
